@inject Microsoft.Extensions.Localization.IStringLocalizer<UserWeb.SharedResource> L
@{
    ViewData["Title"] = L["Login"];
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="container section-space">
    <div class="auth-shell reveal-on-scroll">
        <div class="admin-form auth-card">
            <h2>@L["Login"]</h2>
            <p class="auth-subtitle">@L["LoginSubtitle"]</p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label>@L["Email"]</label>
                    <input name="email" class="form-control" type="email" required />
                </div>

                <div class="form-group">
                    <label>@L["Password"]</label>
                    <input name="password" class="form-control" type="password" required />
                </div>

                <div class="admin-actions auth-actions">
                    <button type="submit" class="btn-minimal">@L["Login"]</button>
                    <a asp-action="Register" class="btn-minimal">@L["Register"]</a>
                </div>
            </form>
        </div>
    </div>
</section>

